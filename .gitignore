# CI/CD Secrets
# ==============

# GitHub Actions secrets (if applicable)
.github/workflows/*.secret
.github/workflows/secrets.txt

# Build artifacts with embedded secrets
dist/
build/


# Exclude from sync/backup
# ==========================

# Large binary files that shouldn't be in version control
*.iso
*.dmg
*.exe
*.deb
*.apk
*.apks
*.xapk
*.apkm


# Exception: Track documentation examples
# =========================================
# The following are NOT ignored (important for project):
# - README.md
# - SECURITY.md
# - CONTRIBUTING.md
# - CHANGELOG.md
# - VERSION (project version)
# - apk (main script)
# - scripts/ (public utility scripts)

!.gitkeep
